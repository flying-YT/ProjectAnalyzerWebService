<?xml version="1.0" encoding="utf-8"?>
<!--
  IISへの発行(publish)時、<aspNetCore>要素とハンドラーはSDKが自動で書き換えます。
  ここで指定しているrequestFilteringのrequestLimitsは保持され、公開後のweb.configにも反映されます。
  maxAllowedContentLengthはIISのリクエストフィルタリングの上限(既定30,000,000バイト≒28.6MB)で、
  これを超えるとHTTP 404.13「要求のエンティティが大きすぎる」になるため、アップロード上限(100MB)に合わせています。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ProjectAnalyzerWebService.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 100MB = 104,857,600バイト（Program.csのMaxUploadBytesと一致させること） -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
